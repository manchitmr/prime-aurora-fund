# Local Netlify folder
.netlify

# Dependencies
node_modules

# Vendored Netlify agent-skill docs. Reproducible from skills-lock.json via
# `npx skills add netlify/context-and-tools`, so they are not tracked here.
.claude/skills

# Build output (regenerated by `npm run build` on every deploy)
dashboard/editor.js

# Source workbooks: these carry household names and payment history, and are
# not needed to build or deploy. The committee keeps the authoritative copies.
*.xlsx
*.xlsm
*.csv

# Secrets
.env
.env.*
!.env.example

# macOS
.DS_Store
